      "type": "postgres",
      "uid": "pg"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT service, COALESCE(SUM(event_count) FILTER (WHERE severity='P1'),0) AS \"P1\", COALESCE(SUM(event_count) FILTER (WHERE severity='P2'),0) AS \"P2\", COALESCE(SUM(event_count) FILTER (WHERE severity='P3'),0) AS \"P3\", COALESCE(SUM(event_count) FILTER (WHERE severity='P4'),0) AS \"P4\", COALESCE(SUM(event_count) FILTER (WHERE severity='Unclassified'),0) AS \"Unclassified\" FROM v_error_events WHERE $__timeFilter(window_start) AND service IN ($service) AND severity IN ($severity) AND error_type IN ($error_type) GROUP BY service ORDER BY SUM(event_count) DESC"
    }
   ],
