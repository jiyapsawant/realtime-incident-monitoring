     "editorMode": "code",
     "rawSql": "SELECT ROUND(100.0*SUM(log_count) FILTER (WHERE level IN ('ERROR','FATAL','CRITICAL'))/NULLIF(SUM(log_count),0),2) AS \"Error rate\" FROM log_stats_hourly WHERE $__timeFilter(hour) AND service IN ($service)"
