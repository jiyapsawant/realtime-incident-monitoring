     "rawSql": "SELECT first_seen AS \"First seen\", severity AS \"Sev\", service AS \"Service\", error_type AS \"Type\", root_cause_category AS \"Root cause\", title AS \"Title\", event_count AS \"Events\", resolution_state AS \"State\", ROUND(ttr_minutes::numeric,1) AS \"TTR (min)\", root_cause AS \"Probable cause (LLM)\" FROM v_incidents WHERE $__timeFilter(first_seen) AND service IN ($service) AND severity IN ($severity) AND error_type IN ($error_type) ORDER BY first_seen DESC LIMIT 100"
