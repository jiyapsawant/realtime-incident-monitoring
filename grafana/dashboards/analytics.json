     "editorMode": "code",
     "rawSql": "SELECT $__timeGroupAlias(first_seen,'10m'), severity AS metric, COUNT(*) AS incidents FROM v_incidents WHERE $__timeFilter(first_seen) AND service IN ($service) AND severity IN ($severity) AND error_type IN ($error_type) GROUP BY 1,2 ORDER BY 1"
