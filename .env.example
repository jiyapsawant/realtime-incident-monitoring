# Copy to .env and fill in. The pipeline runs without keys (heuristic summaries, no alerts).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
# Summarizer tuning
MIN_EVENTS_PER_CLUSTER=5
DEDUP_MINUTES=15
POLL_SECONDS=10
# Producer tuning
LOGS_PER_SECOND=20
INCIDENT_EVERY_SECONDS=90

# Analytics
RESOLVE_AFTER_MINUTES=5
ANALYTICS_REFRESH_SECONDS=300
